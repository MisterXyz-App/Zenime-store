# ── Flask core ────────────────────────────────────────────────────────────
SECRET_KEY=ganti-dengan-random-string-panjang
FLASK_ENV=development
FLASK_DEBUG=true

# ── Supabase project ─────────────────────────────────────────────────────
# URL project Supabase, mis. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key Supabase — HANYA dipakai di server (Flask), JANGAN PERNAH
# dikirim ke browser/client. Dipakai untuk memanggil Edge Function.
SUPABASE_SERVICE_ROLE_KEY=

# ── Nama Edge Function di Supabase ───────────────────────────────────────
# Sudah ada default masuk akal di config.py, override di sini kalau nama
# function di project Supabase-mu berbeda.
SUPABASE_FN_CREATE_INVOICE=sakurupiah-create-invoice
SUPABASE_FN_CHECK_STATUS=sakurupiah-check-status
SUPABASE_FN_LIST_PACKAGES=zenime-list-packages

# Gateway aktif (Aulaa, QRIS) -- opsional, ini nilai default-nya sudah
# sama persis. check_status TIDAK butuh baris terpisah karena
# aulaa-check-status baca RPC yang sama dengan sakurupiah-check-status.
SUPABASE_FN_CREATE_INVOICE_AULAA=aulaa-create-invoice

# ── HTTP client ke Edge Function ─────────────────────────────────────────
EDGE_FUNCTION_TIMEOUT_SECONDS=12

# ── Cek update Zenime (proxy GitHub Releases) ────────────────────────────
# GITHUB_REPO_OWNER, GITHUB_REPO_NAME, dan GITHUB_CACHE_SECONDS di-hardcode
# di config.py (nilainya tetap, gak perlu di-set di sini).

# Personal Access Token GitHub, OPSIONAL (scope publik cukup). Kalau diisi,
# limit request ke GitHub API naik dari 60/jam jadi 5000/jam. Cukup dibuat
# di GitHub Settings > Developer settings > Personal access tokens.
GITHUB_TOKEN=

# ── Firebase Remote Config (maintenance mode) ────────────────────────────
# Pakai project Firebase yang SAMA dengan app Android Zenime -- ambil dari
# google-services.json Zenime (atau Firebase Console > Project Settings >
# General > Your apps). Ini nilai public (ikut ke-bundle di APK), BUKAN
# service account, jadi aman di-set langsung sebagai env var biasa.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Nama parameter Remote Config buat saklar maintenance -- bikin dulu di
# Firebase Console > Remote Config (tipe Boolean, default "false").
MAINTENANCE_PARAM_NAME=maintenance_mode
# Opsional, parameter String buat custom pesan maintenance.
MAINTENANCE_MESSAGE_PARAM_NAME=maintenance_message
# Berapa detik hasil fetch Remote Config di-cache di memory.
MAINTENANCE_CACHE_SECONDS=30

# ── Mode pengembangan lokal ───────────────────────────────────────────────
# Kalau true DAN SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY masih kosong,
# backend memakai data paket & invoice dummy supaya frontend tetap bisa
# dikembangkan tanpa Supabase tersambung. Set ke false di production.
USE_MOCK_DATA_WHEN_UNCONFIGURED=true
